# ==============================================================================
# GESTART — DOCKER COMPOSE ROOT ENVIRONMENT VARIABLES (.env on Hetzner VPS)
# Copy this file to .env in the root folder before running `docker compose up -d`
# ==============================================================================

# 1. DOMAINS
FRONTEND_URL=https://gestart.fr
BACKEND_URL=https://api.gestart.fr
VITE_API_URL=https://api.gestart.fr/api

# 2. POSTGRESQL DATABASE CREDENTIALS
DB_USER=gestart
DB_PASSWORD=change_this_strong_postgres_password
DB_NAME=gestart

# 3. REDIS PASSWORD
REDIS_PASSWORD=change_this_strong_redis_password

