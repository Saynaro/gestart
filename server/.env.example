# ─────────────────────────────────────────────────────────────
# CONFIGURATION DU SERVEUR
# ─────────────────────────────────────────────────────────────
PORT=5001
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# ─────────────────────────────────────────────────────────────
# BASE DE DONNÉES (POSTGRESQL + PRISMA)
# ─────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/crm_db?schema=public"

# ─────────────────────────────────────────────────────────────
# SÉCURITÉ JWT (AUTHENTIFICATION)
# ─────────────────────────────────────────────────────────────
JWT_SECRET=super_secret_jwt_access_token_key_change_me_in_production
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=super_secret_jwt_refresh_token_key_change_me_in_production
JWT_REFRESH_EXPIRES_IN=7d

# ─────────────────────────────────────────────────────────────
# STRIPE (PAIEMENTS ET ABONNEMENTS SAAS)
# ─────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_51...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_SUCCESS_URL=http://localhost:5173/subscription/success
STRIPE_CANCEL_URL=http://localhost:5173/subscription/cancel

# ─────────────────────────────────────────────────────────────
# TWILIO (SMS & MESSAGERIE)
# ─────────────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=ACXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+33600000000

# ─────────────────────────────────────────────────────────────
# CLOUDINARY (MEDIA & PHOTOS UPLOAD)
# ─────────────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ─────────────────────────────────────────────────────────────
# AUTHENTIFICATION GOOGLE OAUTH 2.0
# ─────────────────────────────────────────────────────────────
# 1. Créer une application sur https://console.cloud.google.com
# 2. Configurer les origines JavaScript autorisées : http://localhost:5173
# 3. Configurer l'URI de redirection : http://localhost:5001/api/v1/auth/google/callback
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your_google_client_secret

# ─────────────────────────────────────────────────────────────
# AUTHENTIFICATION APPLE SIGN IN
# ─────────────────────────────────────────────────────────────
# 1. Configurer App ID, Service ID et Key sur https://developer.apple.com
# 2. Télécharger le fichier de clé privée (.p8)
APPLE_CLIENT_ID=com.yourcompany.crm.service
APPLE_TEAM_ID=YOUR_TEAM_ID
APPLE_KEY_ID=YOUR_KEY_ID
APPLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# ─────────────────────────────────────────────────────────────
# ENVOI D'EMAILS (NODEMAILER / RESEND / SMTP)
# ─────────────────────────────────────────────────────────────
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASS=re_your_api_key
EMAIL_FROM="ClimPro CRM <noreply@climpro.fr>"
