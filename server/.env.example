# ==============================================================================
# CLIMPRO CRM — CONFIGURATION COMPLÈTE DES VARIABLES D'ENVIRONNEMENT (.env)
# ==============================================================================

# ─────────────────────────────────────────────────────────────
# 1. CONFIGURATION DU SERVEUR & URLS
# ─────────────────────────────────────────────────────────────
PORT=5001
NODE_ENV=development
# URL de votre frontend React (ex: http://localhost:5173 en local, ou https://app.votre-domaine.fr en prod)
FRONTEND_URL=http://localhost:5173
# URL de votre backend Express (ex: http://localhost:5001 en local, ou https://api.votre-domaine.fr en prod)
BACKEND_URL=http://localhost:5001

# ─────────────────────────────────────────────────────────────
# 2. BASE DE DONNÉES & REDIS CACHE
# ─────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/gestart?schema=public"

# Redis Cache & Rate Limiting URL (ex: redis://127.0.0.1:6379 ou redis://:password@host:port)
REDIS_URL="redis://127.0.0.1:6379"
REDIS_HOST="127.0.0.1"
REDIS_PORT=6379
# REDIS_PASSWORD="votre_mot_de_passe_redis_si_necessaire"

# ─────────────────────────────────────────────────────────────
# 3. SÉCURITÉ & CHIFFREMENT DES CANAUX (AES-256-GCM / JWT)
# ─────────────────────────────────────────────────────────────
JWT_SECRET=super_secret_jwt_access_token_key_change_me_in_production
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=super_secret_jwt_refresh_token_key_change_me_in_production
JWT_REFRESH_EXPIRES_IN=7d

# Clé secrète de chiffrement pour les tokens Meta/WhatsApp, OAuth Refresh Tokens et mots de passe SMTP
# Générer une chaîne aléatoire sécurisée de 32 caractères (ou hexadécimal) :
# Commande terminal pour générer : openssl rand -hex 32
ENCRYPTION_KEY=votre_cle_secrete_de_chiffrement_aes_256_32_bytes_min

# ─────────────────────────────────────────────────────────────
# 4. TWILIO (SMS OMNICANAL)
# ─────────────────────────────────────────────────────────────
# Où trouver ces clés :
# 1. Créez un compte sur https://console.twilio.com
# 2. Sur votre Dashboard principal (Account Info), copiez "Account SID" et "Auth Token"
# 3. Achetez un numéro dans Phone Numbers > Manage > Buy a number
# 4. Pour les tests locaux sans compte payant, mettez TWILIO_MOCK=true
TWILIO_ACCOUNT_SID=ACXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_SMS_NUMBER=+33600000000
TWILIO_PHONE_NUMBER=+33600000000
TWILIO_MOCK=false

# URL de Webhook à configurer dans la console Twilio (Active Numbers > Messaging > A MESSAGE COMES IN) :
# https://api.votre-domaine.fr/api/v1/webhooks/twilio/sms

# ─────────────────────────────────────────────────────────────
# 5. META WHATSAPP BUSINESS CLOUD API
# ─────────────────────────────────────────────────────────────
# Où trouver ces clés :
# 1. Créez un compte développeur sur https://developers.facebook.com
# 2. My Apps > Create App > Type : "Business" > Nom de l'application
# 3. Ajoutez le produit "WhatsApp" > Set up
# 4. WhatsApp > API Setup :
#    - Copiez le "Phone number ID" (ex: 104829384729102)
#    - Copiez le "WhatsApp Business Account ID" (WABA ID)
# 5. Dans App Settings > Basic :
#    - Copiez "App ID" (META_APP_ID)
#    - Copiez "App Secret" (META_APP_SECRET)
# 6. Pour le Token Permanent (System User Token) :
#    - Allez sur https://business.facebook.com > Paramètres d'entreprise > Utilisateurs système
#    - Créez un utilisateur système "Admin", puis cliquez sur "Générer un jeton"
#    - Cochez les permissions : whatsapp_business_messaging, whatsapp_business_management
#    - Copiez le jeton généré dans WHATSAPP_ACCESS_TOKEN
# 7. Configuration du Webhook Meta :
#    - Dans developers.facebook.com > WhatsApp > Configuration > Webhook
#    - Callback URL : https://api.votre-domaine.fr/api/v1/webhooks/whatsapp
#    - Verify Token : la même valeur que WHATSAPP_WEBHOOK_VERIFY_TOKEN ci-dessous
#    - Champs à cocher : "messages" et "message_template_status_update"
META_APP_ID=your_meta_app_id
META_APP_SECRET=your_meta_app_secret
WHATSAPP_PHONE_NUMBER_ID=your_meta_phone_number_id
WHATSAPP_WABA_ID=your_meta_waba_id
WHATSAPP_ACCESS_TOKEN=EAAG...votre_permanent_system_user_access_token
WHATSAPP_WEBHOOK_VERIFY_TOKEN=climpro_meta_wa_verify_2026
WHATSAPP_BUSINESS_PHONE=+336XXXXXXXXX

# ─────────────────────────────────────────────────────────────
# 6. EMAIL GLOBAL FALLBACK & ENVOI SMTP (RESEND / GMAIL / OVH)
# ─────────────────────────────────────────────────────────────
# Options recommandées :
# Option A : Gmail avec Mot de passe d'application (https://myaccount.google.com/apppasswords)
#   SMTP_HOST=smtp.gmail.com | SMTP_PORT=465 | SMTP_USER=vous@gmail.com | SMTP_PASS=votre_code_16_caracteres
# Option B : Resend.com (https://resend.com/api-keys)
#   SMTP_HOST=smtp.resend.com | SMTP_PORT=587 | SMTP_USER=resend | SMTP_PASS=re_xxxxxxxxx
# Option C : OVH / Hostinger / Mailgun / SendGrid
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=contact@votre-entreprise.fr
SMTP_PASS=your_email_or_app_password
EMAIL_FROM="Votre Entreprise" <contact@votre-entreprise.fr>

# ─────────────────────────────────────────────────────────────
# 7. GOOGLE WORKSPACE OAUTH 2.0 (CONNEXION EMAIL CLIENT)
# ─────────────────────────────────────────────────────────────
# Où trouver ces clés :
# 1. Allez sur https://console.cloud.google.com
# 2. APIs & Services > Credentials > Create Credentials > OAuth client ID (Web application)
# 3. Authorized redirect URIs :
#    - http://localhost:5001/api/v1/communication/email/google/callback (local)
#    - https://api.votre-domaine.fr/api/v1/communication/email/google/callback (prod)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your_google_client_secret

# ─────────────────────────────────────────────────────────────
# 8. MICROSOFT 365 OAUTH (AZURE ENTRA ID)
# ─────────────────────────────────────────────────────────────
# Où trouver ces clés :
# 1. Allez sur https://portal.azure.com > App registrations > New registration
# 2. Copiez "Application (client) ID" et "Directory (tenant) ID"
# 3. Certificates & Secrets > New client secret
# 4. API Permissions > Add a permission > Microsoft Graph (Mail.Send, Mail.ReadWrite)
# 5. Redirect URI : https://api.votre-domaine.fr/api/v1/communication/email/microsoft/callback
MICROSOFT_CLIENT_ID=your_microsoft_client_id
MICROSOFT_CLIENT_SECRET=your_microsoft_client_secret
MICROSOFT_TENANT_ID=common

# ─────────────────────────────────────────────────────────────
# 9. STRIPE & STRIPE CONNECT (PAIEMENTS FACTURES & ABONNEMENTS)
# ─────────────────────────────────────────────────────────────
# https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_51P...
STRIPE_PUBLISHABLE_KEY=pk_test_51P...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_CLIENT_ID=ca_...
STRIPE_CONNECT_WEBHOOK_SECRET=whsec_...
STRIPE_CONNECT_CALLBACK_URL=http://localhost:5001/api/v1/stripe/connect/callback
STRIPE_SUCCESS_URL=http://localhost:5173/subscription/success
STRIPE_CANCEL_URL=http://localhost:5173/subscription/cancel

# ─────────────────────────────────────────────────────────────
# 10. CLOUDINARY (STOCKAGE DEVIS, FACTURES, PHOTOS CHANTIER)
# ─────────────────────────────────────────────────────────────
# https://console.cloudinary.com
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ─────────────────────────────────────────────────────────────
# 11. OPEN BANKING (POWENS / BUDGET INSIGHT)
# ─────────────────────────────────────────────────────────────
POWENS_CLIENT_ID=your_powens_client_id
POWENS_CLIENT_SECRET=your_powens_client_secret
POWENS_BASE_URL=https://sandbox.powens.com

# ─────────────────────────────────────────────────────────────
# 12. FACTURATION ÉLECTRONIQUE (B2BROUTER PPF 2026)
# ─────────────────────────────────────────────────────────────
B2BROUTER_API_KEY=your_b2brouter_api_key
B2BROUTER_ENVIRONMENT=staging
