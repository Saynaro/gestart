// TABLES ET LEURS RÔLES:
//
// ── ABONNEMENT ──────────────────────────────────────────────
// Plan              → Les 3 offres Starter/Pro/Unlimited
// Subscription      → L'abonnement actif de la company
// Payment           → Historique des paiements Stripe
//
// ── SOCIÉTÉ ─────────────────────────────────────────────────
// Company           → La société de l'installateur (tenant principal)
// CompanySettings   → Paramètres: SMS, factures, rappels ТО, horaires
// TradeCategory     → Domaines d'activité (clim, chaudière...) choisis à l'inscription
//
// ── UTILISATEURS ────────────────────────────────────────────
// User              → Owner / Manager / Technicien
// PushToken         → Tokens FCM pour notifications push
// Invitation        → Invitations email pour rejoindre la company
//
// ── CATALOGUE ───────────────────────────────────────────────
// CatalogItem       → Matériaux et prestations sauvegardés (réutilisables)
// InterventionTypeItem → Types d'interventions sauvegardés (réutilisables)
//
// ── CLIENTS ─────────────────────────────────────────────────
// Client            → Les clients de l'installateur
// Equipment         → Équipements installés chez le client
//
// ── INTERVENTIONS ───────────────────────────────────────────
// Intervention      → Chaque visite chez un client
// InterventionPhoto → Photos avant/après
//
// ── DEVIS & FACTURES ────────────────────────────────────────
// Quote             → Devis (D-2026-001)
// QuoteLine         → Lignes du devis → référence CatalogItem
// Invoice           → Facture (INV-2026-001) + PDF A4
// InvoiceLine       → Lignes de la facture → référence CatalogItem
//
// ── MESSAGERIE ──────────────────────────────────────────────
// SmsLog            → Historique SMS complet par client
// SmsUsage          → Compteur SMS mensuel par company
//
// ── NOTIFICATIONS ───────────────────────────────────────────
// Notification      → Toutes les notifs push/email/in-app
//
// ── DIVERS ──────────────────────────────────────────────────
// QuoteRequest      → Demandes depuis le formulaire public
// AuditLog          → Historique des actions (qui a fait quoi)
//
// ============================================================

generator client {
  provider = "prisma-client-js"
  output   = "./generated"
}

datasource db {
  provider = "postgresql"
}

// ============================================================
// ENUMS
// ============================================================

