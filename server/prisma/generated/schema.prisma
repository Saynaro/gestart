// ============================================================
// PLAN
// ─────────────────────────────────────────────────────────────
// Définit les 3 offres disponibles.
// Créées en seed, jamais modifiées par l'utilisateur.
// Liées à Subscription (une company → un plan actif).
// ============================================================

model Plan {
  id          String   @id @default(cuid())
  name        PlanName @unique
  displayName String // "Starter", "Pro", "Unlimited"

  priceMonthly Float // 39, 89, 149
  priceAnnual  Float // 31.20, 71.20, 119.20 (-20%)

  // Limites (-1 = illimité)
  maxClients     Int // 20, 100, -1
  maxTechnicians Int // 1, 5, -1
  maxSmsPerMonth Int // 50, 200, 500
  extraSmsCost   Float @default(0.10)

  // Fonctionnalités
  hasMobileApp          Boolean @default(false)
  hasAutoSmsReminders   Boolean @default(false) // rappels ТО automatiques
  hasAdvancedReports    Boolean @default(false) // rapports détaillés
  hasChorusPro          Boolean @default(false) // facturation électronique
  hasDedicatedSmsNumber Boolean @default(false)
  hasAccountManager     Boolean @default(false)
  hasPrioritySupport    Boolean @default(false)
  hasPremiumSettings    Boolean @default(false) // page Premium dans sidebar

  stripeMonthlyPriceId String?
  stripeAnnualPriceId  String?

  subscriptions Subscription[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ============================================================
// COMPANY
// ─────────────────────────────────────────────────────────────
// La société de l'installateur. C'est le tenant principal.
// TOUT appartient à une Company (clients, interventions, etc.)
//
// RELATIONS:
// → CompanySettings (1:1) — paramètres
// → Subscription (1:1) — abonnement actif
// → TradeCategory (1:N) — domaines d'activité choisis à l'inscription
// → User (1:N) — équipe
// → Client (1:N) — clients
// → CatalogItem (1:N) — catalogue matériaux/prestations
// → InterventionTypeItem (1:N) — types d'interventions personnalisés
// ============================================================

model Company {
  id              String  @id @default(cuid())
  name            String
  siret           String? @unique // 14 chiffres
  siren           String? @unique // 9 chiffres (= siret[0..8])
  tvaNumber       String? // FR + 11 chiffres (calculé depuis SIREN)
  legalForm       String? // "SARL", "SAS", "SA", "EI", "Auto-entrepreneur", "SNC"...
  rcsNumber       String? // Numéro RCS + ville greffe ex: "Paris B 123 456 789"
  shareCapital    String? // Capital social ex: "10 000€" (obligatoire SARL/SAS/SA)
  nafCode         String? // Code NAF/APE ex: "4322A" (récupéré depuis API SIRENE)
  isTvaFranchise  Boolean @default(false) // Auto-entrepreneur sans TVA → mention art.293B CGI
  isSubcontractor Boolean @default(false) // Sous-traitant BTP → autoliquidation TVA
  phone           String?
  email           String?
  address         String?
  city            String?
  postalCode      String?
  logoUrl         String?
  signatureUrl    String?
  website         String?
  slug            String? @unique // "dupont-climatisation" pour formulaire public

  // Numéro Twilio virtuel pour les SMS
  smsNumber String?

  // ── STRIPE CONNECT (paiement en ligne factures) ───────────
  // L'installateur connecte son propre compte Stripe
  // L'argent va directement sur son compte bancaire
  stripeAccountId        String?                @unique // ex: "acct_1ABC..."
  stripeAccountStatus    String? // "pending", "active", "restricted"
  onlinePaymentEnabled   Boolean                @default(false) // true quand Stripe connecté
  stripeOnboardingStatus StripeOnboardingStatus @default(NOT_STARTED)
  stripeChargesEnabled   Boolean                @default(false)
  stripePayoutsEnabled   Boolean                @default(false)
  stripeDetailsSubmitted Boolean                @default(false)
  stripeConnectedAt      DateTime?

  // Relations
  users               User[]
  clients             Client[]
  interventions       Intervention[]
  invoices            Invoice[]
  quotes              Quote[]
  smsLogs             SmsLog[]
  whatsappConnections WhatsAppConnection[]
  emailConnections    EmailConnection[]
  notifications       Notification[]
  invitations         Invitation[]
  subscription        Subscription?
  settings            CompanySettings?
  smsUsage            SmsUsage[]
  auditLogs           AuditLog[]
  quoteRequests       QuoteRequest[]
  catalogItems        CatalogItem[]
  interventionTypes   InterventionTypeItem[]
  tradeCategories     CompanyTradeCategory[]
  invoiceTransactions InvoiceTransaction[]
  bankConnection      BankConnection?
  bankAccounts        BankAccount[]
  bankTransactions    BankTransaction[]
  serviceTypes        ServiceType[]
  reminderAutomations ReminderAutomation[]
  reminderExecutions  ReminderExecution[]

  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  accountingExports     AccountingExport[]
  tvaSummaries          TvaSummary[]
  accountingIntegration AccountingIntegration?
  einvoicingConnection  EInvoicingConnection?
  receivedInvoices      ReceivedInvoice[]
  einvoicingEvents      EInvoicingEvent[]
  einvoicingJobs        EInvoicingJob[]
}

// ============================================================
// COMPANY TRADE CATEGORY
// ─────────────────────────────────────────────────────────────
// Domaines d'activité choisis par l'installateur à l'inscription.
// Exemples: Pompe à chaleur, VMC, Chaudière gaz...
//
// RELATIONS:
// → Company (N:1) — appartient à une company
// → TradeCategory (N:1) — référence le domaine du catalogue global
//
// Lors de l'inscription, l'installateur choisit un ou plusieurs
// domaines depuis la liste prédéfinie dans TradeCategory.
// ============================================================

model CompanyTradeCategory {
  id              String        @id @default(cuid())
  companyId       String
  company         Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  tradeCategoryId String
  tradeCategory   TradeCategory @relation(fields: [tradeCategoryId], references: [id])

  createdAt DateTime @default(now())

  @@unique([companyId, tradeCategoryId])
}

// ============================================================
// TRADE CATEGORY
// ─────────────────────────────────────────────────────────────
// Liste globale des domaines d'activité disponibles.
// Créée en seed. L'installateur choisit parmi cette liste.
//
// Exemples depuis la liste fournie:
//   - Pompe à chaleur : chauffage
//   - Chauffe-Eau Thermodynamique
//   - Ventilation mécanique (VMC)
//   - Panneaux solaires photovoltaïques
//   - Chaudière condensation gaz ou fioul
//   - Poêle ou insert bois
//   etc.
//
// RELATIONS:
// → CompanyTradeCategory (1:N) — companies qui ont ce domaine
// ============================================================

model TradeCategory {
  id          String  @id @default(cuid())
  name        String  @unique // "Pompe à chaleur : chauffage"
  slug        String  @unique // "pompe-a-chaleur-chauffage"
  description String?
  icon        String? // emoji ou nom d'icône
  isActive    Boolean @default(true)
  sortOrder   Int     @default(0) // ordre d'affichage

  companies CompanyTradeCategory[]

  createdAt DateTime @default(now())
}

// ============================================================
// SUBSCRIPTION
// ─────────────────────────────────────────────────────────────
// L'abonnement actif de la company. Une seule par company.
//
// RELATIONS:
// → Company (1:1) — appartient à une company
// → Plan (N:1) — quel plan est actif
// → Payment (1:N) — historique des paiements
// ============================================================

model Subscription {
  id        String  @id @default(cuid())
  companyId String  @unique
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  planId    String
  plan      Plan    @relation(fields: [planId], references: [id])

  status PlanStatus       @default(TRIALING)
  cycle  PlanBillingCycle @default(MONTHLY)

  trialEndsAt        DateTime?
  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?
  cancelledAt        DateTime?

  stripeCustomerId     String? @unique
  stripeSubscriptionId String? @unique

  // Compteur SMS mensuel (reset le 1er du mois via cron)
  smsUsedThisMonth Int       @default(0)
  smsResetAt       DateTime?

  payments Payment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ============================================================
// PAYMENT
// ─────────────────────────────────────────────────────────────
// Historique des paiements Stripe.
// Créé automatiquement via webhook Stripe.
//
// RELATIONS:
// → Subscription (N:1) — rattaché à un abonnement
// ============================================================

model Payment {
  id             String       @id @default(cuid())
  subscriptionId String
  subscription   Subscription @relation(fields: [subscriptionId], references: [id])

  amount   Float
  currency String         @default("EUR")
  status   String // succeeded, failed, pending
  method   PaymentMethod?

  stripePaymentIntentId String? @unique
  stripeInvoiceUrl      String? // lien vers la facture Stripe

  paidAt    DateTime?
  createdAt DateTime  @default(now())
}

// ============================================================
// COMPANY SETTINGS
// ─────────────────────────────────────────────────────────────
// Tous les paramètres de la company. Une seule ligne par company.
//
// CONTIENT:
// - Paramètres SMS (rappels ТО, templates, signature)
// - Délai de rappel ТО (configurable en Premium)
// - Notifications (quelles notifs, quels canaux)
// - Numérotation auto des factures/devis
// - Paramètres PDF (pied de page, conditions)
// - Horaires de travail
//
// RELATIONS:
// → Company (1:1) — appartient à une company
// ============================================================

model CompanySettings {
  id        String  @id @default(cuid())
  companyId String  @unique
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  // ── CANAUX PAR TYPE DE MESSAGE ───────────────────────────
  // Définit quel canal utiliser par défaut selon le type
  // Peut être écrasé par le canal préféré du client
  defaultChannelReminder PreferredChannel @default(SMS)
  defaultChannelQuote    PreferredChannel @default(EMAIL)
  defaultChannelInvoice  PreferredChannel @default(EMAIL)
  defaultChannelConfirm  PreferredChannel @default(SMS)

  // ── SMS RAPPELS ТО ────────────────────────────────────────
  // Configurable uniquement en plan Pro/Unlimited (hasPremiumSettings)
  smsReminderEnabled       Boolean @default(true)
  // Délai en jours avant le ТО (configurable en Premium: 7, 14, 30, 60, 90)
  smsDaysBefore            Int     @default(30)
  // Deuxième rappel (optionnel, Premium)
  smsSecondReminderEnabled Boolean @default(false)
  smsSecondReminderDays    Int     @default(7) // 7 jours avant
  // Template SMS personnalisé
  smsReminderTemplate      String?
  // Signature en fin de SMS
  smsSignature             String? // "— Dupont Climatisation"

  // ── RELANCES AUTOMATIQUES FACTURES & DEVIS ────────────────
  invoiceReminderEnabled Boolean @default(true)
  invoiceReminderDays    Int     @default(7) // délai après envoi en jours
  quoteReminderEnabled   Boolean @default(true)
  quoteReminderDays      Int     @default(5) // délai après envoi en jours

  // ── NOTIFICATIONS OWNER/MANAGER ───────────────────────────
  notifyNewClient         Boolean @default(true)
  notifyNewMessage        Boolean @default(true)
  notifyInterventionDone  Boolean @default(true)
  notifyInvoicePaid       Boolean @default(true)
  notifyUrgentMaintenance Boolean @default(true)
  notifyQuoteRequest      Boolean @default(true)
  notifyPlanExpiring      Boolean @default(true)
  notifySmsLimit          Boolean @default(true)

  // ── NOTIFICATIONS TECHNICIEN ──────────────────────────────
  notifyTechAssigned    Boolean @default(true)
  notifyTechUpdated     Boolean @default(true)
  notifyTechCancelled   Boolean @default(true)
  notifyTechReminder24h Boolean @default(true)
  notifyTechReminder1h  Boolean @default(true)

  ownerChannels NotificationChannel[] @default([PUSH, IN_APP])
  techChannels  NotificationChannel[] @default([PUSH, IN_APP])

  // ── NUMÉROTATION AUTO ─────────────────────────────────────
  invoicePrefix     String @default("INV") // INV-2026-001
  invoiceNextNumber Int    @default(1)
  quotePrefix       String @default("D") // D-2026-001
  quoteNextNumber   Int    @default(1)

  invoiceFooter         String? // texte pied de page PDF
  invoiceConditions     String? // conditions de paiement
  invoiceColor          String? @default("#556B2F") // couleur principale PDF factures & devis
  documentCustomization Json? // style visuel par défaut des documents (couleurs, structure, polices, visibilité)
  defaultTvaRate        Float   @default(20)
  defaultPaymentDays    Int     @default(30) // délai paiement facture

  // ── DEVIS ─────────────────────────────────────────────────
  defaultValidDays Int @default(30) // validité devis en jours

  // ── HORAIRES ─────────────────────────────────────────────
  workStartHour Int   @default(8)
  workEndHour   Int   @default(18)
  workDays      Int[] @default([1, 2, 3, 4, 5]) // 1=Lun, 7=Dim

  // ── COORDONNÉES BANCAIRES (RIB / IBAN FACTURES & DEVIS) ──
  bankName             String? // "La Banque Postale", "BNP Paribas", "Boursorama Pro", etc.
  bankIban             String? // "FR76 3000 3020 5001 2345 6789 012"
  bankBic              String? // "BNPAFRPPXXX"
  bankAccountOwner     String? // "Dupont Climatisation SAS"
  bankTransferEnabled  Boolean         @default(true)
  stripePaymentEnabled Boolean         @default(false)
  stripeFeeBearer      StripeFeeBearer @default(COMPANY)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ============================================================
// USER
// ─────────────────────────────────────────────────────────────
// Membres de la company: Owner, Manager, Technicien.
//
// RELATIONS:
// → Company (N:1) — appartient à une company
// → PushToken (1:N) — tokens FCM pour push
// → Intervention (1:N) — interventions assignées (technicien)
// → Notification (1:N) — ses notifications
// ============================================================

model User {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  email     String   @unique
  password  String
  firstName String
  lastName  String
  phone     String?
  avatarUrl String?
  jobTitle  String?
  role      UserRole @default(TECHNICIAN)
  isActive  Boolean  @default(true)

  // Auth & Security tokens
  refreshTokenHash    String?
  emailVerified       Boolean   @default(false)
  emailVerifyToken    String?
  passwordResetToken  String?
  passwordResetExpiry DateTime?
  lastLoginAt         DateTime?

  // ── DOUBLE AUTHENTIFICATION (2FA) ─────────────
  twoFactorEnabled Boolean   @default(false)
  twoFactorSecret  String?
  twoFactorCode    String?
  twoFactorExpiry  DateTime?

  pushTokens           PushToken[]
  interventions        Intervention[] @relation("TechnicianInterventions")
  notifications        Notification[]
  createdClients       Client[]       @relation("ClientCreatedBy")
  createdInterventions Intervention[] @relation("InterventionCreatedBy")
  auditLogs            AuditLog[]
  sessions             UserSession[]
  loginHistories       LoginHistory[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ============================================================
// USER SESSION
// ─────────────────────────────────────────────────────────────
// Sessions actives par appareil pour l'utilisateur.
// ============================================================

model UserSession {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  device          String // e.g. "MacBook Pro 16\" (macOS)"
  browser         String // e.g. "Google Chrome 127.0"
  ip              String // e.g. "82.64.120.45"
  location        String? // e.g. "Nice, France"
  tokenIdentifier String?
  isCurrent       Boolean  @default(false)
  lastActiveAt    DateTime @default(now())
  createdAt       DateTime @default(now())

  @@index([userId])
}

// ============================================================
// LOGIN HISTORY
// ─────────────────────────────────────────────────────────────
// Historique des connexions récentes.
// ============================================================

model LoginHistory {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  email     String
  ip        String
  device    String
  status    String   @default("Succès") // "Succès", "Échec - Mot de passe incorrect", etc.
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([email])
}

// ============================================================
// PUSH TOKEN
// ─────────────────────────────────────────────────────────────
// Tokens FCM pour notifications push mobile/web.
// Un user peut avoir plusieurs tokens (iPhone + Chrome + Android).
//
// RELATIONS:
// → User (N:1) — appartient à un user
// ============================================================

model PushToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  device    String? // "iPhone 15 Pro"
  platform  String? // "ios", "android", "web"
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
}

// ============================================================
// INVITATION
// ─────────────────────────────────────────────────────────────
// Invitation email pour rejoindre la company.
// Token unique dans le lien, expire après 7 jours.
//
// RELATIONS:
// → Company (N:1) — appartient à une company
// ============================================================

model Invitation {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  email       String
  role        UserRole         @default(TECHNICIAN)
  token       String           @unique @default(cuid())
  status      InvitationStatus @default(PENDING)
  invitedById String? // userId de celui qui a invité
  expiresAt   DateTime // now() + 7 jours
  acceptedAt  DateTime?
  revokedAt   DateTime?

  createdAt DateTime @default(now())

  @@unique([companyId, email])
}

// ============================================================
// CATALOG ITEM
// ─────────────────────────────────────────────────────────────
// Catalogue des matériaux et prestations de la company.
// Sauvegardé automatiquement quand l'installateur ajoute
// un nouveau produit/service dans un devis ou une facture.
//
// LOGIQUE:
// - L'installateur crée une facture et tape "Tube cuivre 1/2" à 12€
// - → CatalogItem est créé automatiquement
// - La prochaine fois, "Tube cuivre 1/2" apparaît dans la liste
// - Il peut choisir depuis la liste ou modifier le prix pour cette ligne
// - usageCount s'incrémente à chaque utilisation
//
// RELATIONS:
// → Company (N:1) — catalogue propre à chaque company
// → QuoteLine (1:N) — lignes de devis qui utilisent cet article
// → InvoiceLine (1:N) — lignes de facture qui utilisent cet article
// ============================================================

model CatalogItem {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  name        String // "Tube cuivre 1/2", "Main d'oeuvre"
  description String?
  reference   String? // référence interne "REF-001"
  type        CatalogItemType // PRODUCT, SERVICE, PACKAGE

  defaultPrice Float // prix unitaire par défaut
  tvaRate      Float    @default(20)
  unit         ItemUnit @default(UNITE)

  isActive   Boolean @default(true) // archivable
  isFavorite Boolean @default(false) // épinglé en haut
  usageCount Int     @default(0) // tri par popularité

  quoteLines   QuoteLine[]
  invoiceLines InvoiceLine[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([companyId, isActive])
  @@index([companyId, usageCount])
}

// ============================================================
// INTERVENTION TYPE ITEM
// ─────────────────────────────────────────────────────────────
// Types d'interventions personnalisés par company.
// Sauvegardé automatiquement quand l'installateur crée
// un nouveau type dans un formulaire.
//
// TYPES PAR DÉFAUT (créés en seed par company):
//   Installation, Maintenance annuelle, Dépannage,
//   Contrôle, Mise en service, Désinstallation
//
// LOGIQUE:
// - L'installateur tape un nouveau type "Mise en route"
// - → InterventionTypeItem est créé
// - La prochaine fois, "Mise en route" est dans la liste
//
// RELATIONS:
// → Company (N:1) — types propres à chaque company
// → Intervention (1:N) — interventions de ce type
// → Invoice (1:N) — factures de ce type
// ============================================================

model InterventionTypeItem {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  name       String // "Maintenance annuelle", "Dépannage", "Mise en route"
  isDefault  Boolean @default(false) // créé par le système, non supprimable
  isActive   Boolean @default(true)
  usageCount Int     @default(0)
  sortOrder  Int     @default(0)

  interventions Intervention[]
  invoices      Invoice[]
  quotes        Quote[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, name])
  @@index([companyId])
}

// ============================================================
// CLIENT
// ─────────────────────────────────────────────────────────────
// Les clients de l'installateur.
//
// STATUT (calculé chaque nuit par cron):
//   OK      → prochain entretien dans > 60 jours
//   WARNING → prochain entretien dans < 60 jours
//   URGENT  → entretien en retard
//
// RELATIONS:
// → Company (N:1) — appartient à une company
// → Equipment (1:N) — ses équipements
// → Intervention (1:N) — ses interventions
// → Invoice (1:N) — ses factures
// → Quote (1:N) — ses devis
// → SmsLog (1:N) — historique SMS
// ============================================================

model Client {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  createdById String?
  createdBy   User?   @relation("ClientCreatedBy", fields: [createdById], references: [id])

  firstName   String
  lastName    String
  companyName String? // si c'est une société (B2B)
  phone       String
  email       String?
  address     String
  city        String?
  postalCode  String?
  notes       String? // code digicode, remarques
  isActive    Boolean      @default(true)
  status      ClientStatus @default(OK)
  source      String? // "appel", "site_web", "manuel", "parrainage"

  // ── CANAL DE COMMUNICATION PRÉFÉRÉ ──────────────────────
  // Défini dans la fiche client, utilisé pour tous les messages auto
  preferredChannel   PreferredChannel  @default(SMS)
  // Canal spécifique par type de message (optionnel, écrase preferredChannel)
  channelForReminder PreferredChannel? // rappels ТО → défaut: SMS
  channelForQuote    PreferredChannel? // devis → défaut: EMAIL
  channelForInvoice  PreferredChannel? // factures → défaut: EMAIL
  channelForConfirm  PreferredChannel? // confirmation RDV → défaut: SMS

  // ── DONNÉES B2B (si client professionnel) ────────────────
  sirenNumber        String? // 🆕 OBLIGATOIRE sur facture B2B depuis sept. 2026
  clientTvaNumber    String? // N° TVA intracommunautaire du client (B2B UE)
  clientLegalForm    String? // Forme juridique du client si société
  clientNafCode      String? // Code NAF (récupéré depuis API SIRENE auto)
  // Adresse de livraison si différente de l'adresse de facturation
  hasDeliveryAddress Boolean @default(false)
  deliveryAddress    String?
  deliveryCity       String?
  deliveryPostalCode String?

  equipment           Equipment[]
  interventions       Intervention[]
  invoices            Invoice[]
  quotes              Quote[]
  smsLogs             SmsLog[]
  reminderAutomations ReminderAutomation[]
  reminderExecutions  ReminderExecution[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([companyId, status])
  @@index([phone])
}

// ============================================================
// EQUIPMENT
// ─────────────────────────────────────────────────────────────
// Équipements installés chez le client.
// Un client peut avoir plusieurs équipements.
//
// LOGIQUE ТО:
// - installDate + serviceInterval mois = nextServiceDate
// - Quand une intervention COMPLETED → lastServiceDate = now()
//   → nextServiceDate recalculée automatiquement
// - Cron nuit → met à jour client.status selon nextServiceDate
//
// RELATIONS:
// → Client (N:1) — appartient à un client
// → Intervention (1:N) — interventions sur cet équipement
// ============================================================

model Equipment {
  id       String @id @default(cuid())
  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  // Identification
  brand        String // "Daikin", "Mitsubishi"
  model        String? // "3.5kW Inverter"
  serialNumber String? // "DK-2024-1234"
  power        String? // "3.5kW"
  location     String? // "Salon", "Chambre 1"

  // Domaine (lié au TradeCategory slug)
  tradeSlug String? // "pompe-a-chaleur", "climatisation"...

  // Dates
  installDate     DateTime?
  warrantyExpiry  DateTime?
  lastServiceDate DateTime?
  nextServiceDate DateTime? // calculé auto
  serviceInterval Int       @default(12) // mois entre entretiens

  isActive Boolean @default(true)
  notes    String?

  interventions Intervention[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clientId])
  @@index([nextServiceDate]) // utilisé par le cron de rappel
}

// ============================================================
// INTERVENTION
// ─────────────────────────────────────────────────────────────
// Chaque visite chez un client.
//
// CYCLE DE VIE:
// PENDING → assigné → SCHEDULED → technicien démarre → IN_PROGRESS
//   → technicien complète → COMPLETED (ou CANCELLED)
//
// À COMPLETED:
// - Met à jour Equipment.lastServiceDate
// - Recalcule Equipment.nextServiceDate
// - Envoie notif INTERVENTION_COMPLETED au owner
//
// RELATIONS:
// → Company (N:1)
// → Client (N:1)
// → Equipment (N:1) optionnel
// → User/technicien (N:1) optionnel
// → InterventionTypeItem (N:1) — type sauvegardé
// → Invoice (1:1) optionnel
// → Quote (1:1) optionnel
// → InterventionPhoto (1:N)
// ============================================================

model Intervention {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  clientId     String
  client       Client     @relation(fields: [clientId], references: [id])
  equipmentId  String?
  equipment    Equipment? @relation(fields: [equipmentId], references: [id])
  technicianId String?
  technician   User?      @relation("TechnicianInterventions", fields: [technicianId], references: [id])
  createdById  String?
  createdBy    User?      @relation("InterventionCreatedBy", fields: [createdById], references: [id])

  // Type sauvegardé dans le catalogue de types
  interventionTypeId String?
  interventionType   InterventionTypeItem? @relation(fields: [interventionTypeId], references: [id])

  status InterventionStatus @default(PENDING)

  // Planification
  scheduledAt       DateTime?
  estimatedDuration Int? // minutes
  arrivedAt         DateTime?
  startedAt         DateTime?
  completedAt       DateTime?

  // Détails
  title       String
  description String? // instructions pour le technicien
  address     String
  city        String?
  accessCode  String? // code digicode/portail

  // Compte-rendu technicien (saisi après l'intervention)
  techNotes     String?
  materialsUsed String?

  // Signature client
  clientSignature String? // base64
  clientSignedAt  DateTime?

  photos             InterventionPhoto[]
  invoice            Invoice?
  quote              Quote?
  services           InterventionService[]
  resetAutomations   ReminderAutomation[]  @relation("LastCompletedIntervention")
  reminderExecutions ReminderExecution[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([technicianId])
  @@index([scheduledAt])
  @@index([status])
  @@index([companyId, status])
}

// ============================================================
// INTERVENTION PHOTO
// ─────────────────────────────────────────────────────────────
// Photos avant/après prises par le technicien sur place.
// Stockées sur Cloudinary.
//
// RELATIONS:
// → Intervention (N:1) — appartient à une intervention
// ============================================================

model InterventionPhoto {
  id             String       @id @default(cuid())
  interventionId String
  intervention   Intervention @relation(fields: [interventionId], references: [id], onDelete: Cascade)
  url            String // URL Cloudinary
  type           String       @default("after") // "before" | "after"
  caption        String?
  createdAt      DateTime     @default(now())
}

// ============================================================
// QUOTE (Devis)
// ─────────────────────────────────────────────────────────────
// Document commercial envoyé au client avant les travaux.
// Numéroté automatiquement: D-2026-001
// Peut être converti en facture une fois accepté.
//
// RELATIONS:
// → Company (N:1)
// → Client (N:1)
// → InterventionTypeItem (N:1) — type d'intervention
// → Intervention (1:1) optionnel
// → QuoteLine (1:N) — lignes du devis
// ============================================================

model Quote {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  clientId       String
  client         Client        @relation(fields: [clientId], references: [id])
  interventionId String?       @unique
  intervention   Intervention? @relation(fields: [interventionId], references: [id])

  // Type d'intervention sauvegardé
  interventionTypeId String?
  interventionType   InterventionTypeItem? @relation(fields: [interventionTypeId], references: [id])

  number String // D-2026-001 généré auto
  status QuoteStatus @default(DRAFT)

  // Montants (calculés depuis les lignes)
  amountHT  Float
  tvaRate   Float @default(20)
  amountTTC Float

  // Métadonnées
  subject               String? // "Installation clim Daikin salon"
  notes                 String? // notes internes
  conditions            String? // visibles sur le PDF
  documentCustomization Json? // style visuel personnalisé du devis

  validUntil DateTime?
  acceptedAt DateTime?
  refusedAt  DateTime?

  // ── MENTIONS LÉGALES DEVIS ────────────────────────────────
  // Date de réalisation prévue
  serviceDate       DateTime?
  operationType     String?   @default("services")
  // Conditions d'acompte
  depositPercent    Float? // % d'acompte ex: 30 → "Acompte de 30% à la commande"
  depositAmount     Float? // Montant calculé auto
  // Conditions de règlement sur le devis
  paymentConditions String? // "Solde à la livraison"

  // ── SIGNATURE ÉLECTRONIQUE ────────────────────────────────
  // Token unique envoyé dans le lien email au client
  // Ex: climpro.fr/sign/quote/abc123xyz
  signatureToken       String?   @unique
  signatureTokenExpiry DateTime? // expire après 30 jours
  signedAt             DateTime? // quand le client a signé
  signatureUrl         String? // URL du PDF signé (Cloudinary)
  signatureIp          String? // IP du client au moment de la signature
  paidAt               DateTime? // quand le client a payé le devis

  // ── ENVOI EMAIL ───────────────────────────────────────────
  emailSentAt DateTime? // quand l'email a été envoyé
  emailSentTo String? // email destinataire

  // ── RAPPELS AUTOMATIQUES (cron) ───────────────────────────
  // Si devis non signé après X jours → rappel automatique
  reminder1SentAt    DateTime? // rappel automatique envoyé
  reminder2SentAt    DateTime? // 2ème rappel éventuel
  reminderDisabled   Boolean   @default(false)
  customReminderDays Int?

  issuedAt DateTime @default(now())

  lines QuoteLine[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([clientId])
  @@index([status])
}

// ============================================================
// QUOTE LINE
// ─────────────────────────────────────────────────────────────
// Une ligne dans le devis.
//
// LOGIQUE CATALOGUE:
// catalogItemId = "abc" → article choisi depuis le catalogue
// catalogItemId = null  → saisi manuellement
//   → si saveToCtaolog=true (frontend) → bakcend crée CatalogItem
//
// Les données (description, prix) sont COPIÉES à la création.
// Modifier le catalogue ne modifie PAS les devis existants.
//
// RELATIONS:
// → Quote (N:1) — appartient à un devis
// → CatalogItem (N:1) optionnel — article du catalogue
// ============================================================

model QuoteLine {
  id      String @id @default(cuid())
  quoteId String
  quote   Quote  @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  catalogItemId String?
  catalogItem   CatalogItem? @relation(fields: [catalogItemId], references: [id])

  // Données copiées (indépendantes du catalogue après création)
  description String
  reference   String?
  quantity    Float    @default(1)
  unitPrice   Float
  tvaRate     Float    @default(20)
  unit        ItemUnit @default(UNITE)
  discount    Float    @default(0) // remise en %
  total       Float // quantity * unitPrice * (1 - discount/100)

  position Int @default(0) // ordre des lignes

  createdAt DateTime @default(now())

  @@index([quoteId])
  @@index([catalogItemId])
}

// ============================================================
// INVOICE (Facture)
// ─────────────────────────────────────────────────────────────
// Numérotée automatiquement: INV-2026-001
// PDF A4 généré et stocké sur Cloudinary/S3.
// Peut être créée depuis un devis (convertToInvoice)
// ou directement depuis le formulaire.
//
// RELATIONS:
// → Company (N:1)
// → Client (N:1)
// → InterventionTypeItem (N:1) — type d'intervention
// → Intervention (1:1) optionnel
// → InvoiceLine (1:N) — lignes
// ============================================================

model Invoice {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  clientId       String
  client         Client        @relation(fields: [clientId], references: [id])
  interventionId String?       @unique
  intervention   Intervention? @relation(fields: [interventionId], references: [id])

  // Lien vers le devis d'origine si convertie
  sourceQuoteId String? @unique

  // Type d'intervention sauvegardé
  interventionTypeId String?
  interventionType   InterventionTypeItem? @relation(fields: [interventionTypeId], references: [id])

  number String // INV-2026-001
  status InvoiceStatus @default(DRAFT)

  // Montants
  amountHT   Float
  tvaRate    Float @default(20)
  amountTTC  Float
  amountPaid Float @default(0)

  // ── MENTIONS LÉGALES OBLIGATOIRES (loi française 2026) ──
  // Date de réalisation de la prestation (≠ date d'émission)
  serviceDate       DateTime?
  // 🆕 Nature de l'opération (obligatoire facturation électronique)
  operationType     String?   @default("services") // "services", "biens", "mixte"
  // Taux pénalités de retard (obligatoire B2B, minimum 3× taux légal)
  penaltyRate       Float     @default(10) // % annuel, ex: 10%
  // Indemnité forfaitaire de recouvrement (obligatoire B2B depuis loi LME)
  recoveryFee       Float     @default(40) // 40€ fixe par la loi
  // Conditions d'escompte (obligatoire de mentionner même si absent)
  discountTerms     String?   @default("Aucun escompte pour paiement anticipé")
  // Option TVA sur les débits (si applicable)
  tvaOnDebit        Boolean   @default(false)
  // Si client auto-entrepreneur → mention art. 293 B CGI
  isTvaFranchise    Boolean   @default(false)
  // Si sous-traitant BTP → autoliquidation TVA
  isAutoLiquidation Boolean   @default(false)
  // N° bon de commande si établi par le client
  orderNumber       String?

  // Description libre des travaux effectués
  workDescription String? // "Nettoyage filtres, vérification circuit frigorigène..."

  subject               String?
  notes                 String? // notes internes (non visibles sur PDF)
  conditions            String? // visibles sur PDF
  documentCustomization Json? // style visuel personnalisé de la facture

  paymentMethod PaymentMethod?
  paymentRef    String?

  // PDF
  pdfUrl String? // URL du PDF généré (Cloudinary/S3)

  // ── PAIEMENT EN LIGNE (optionnel — Stripe) & VIREMENT ─────
  // Activé si owner veut proposer paiement par carte ou virement
  paymentStatus           InvoicePaymentStatus      @default(PENDING)
  invoicePaymentMethod    InvoicePaymentMethodType?
  bankTransferEnabled     Boolean                   @default(true)
  stripeEnabled           Boolean                   @default(false)
  onlinePaymentEnabled    Boolean                   @default(false)
  // Stripe Payment Intent créé quand client clique "Payer en ligne"
  stripePaymentIntentId   String?                   @unique
  // Lien Stripe Checkout envoyé au client
  stripeCheckoutUrl       String?
  // Session Stripe Checkout ID
  stripeCheckoutSessionId String?                   @unique
  // Token unique pour page de paiement public
  // Ex: climpro.fr/pay/invoice/abc123xyz
  paymentToken            String?                   @unique
  paymentTokenExpiry      DateTime?
  // Quand le client a ouvert le lien de paiement
  paymentLinkOpenedAt     DateTime?

  issuedAt DateTime  @default(now())
  dueAt    DateTime?
  paidAt   DateTime?

  // ── ENVOI EMAIL ───────────────────────────────────────────
  emailSentAt DateTime? // quand l'email a été envoyé
  emailSentTo String? // email destinataire

  // ── RAPPELS AUTOMATIQUES (cron) ───────────────────────────
  // Si facture non payée → rappel automatique
  reminder1SentAt    DateTime? // rappel automatique envoyé
  reminder2SentAt    DateTime? // 2ème rappel éventuel
  reminderSentAt     DateTime? // dernier rappel manuel (bouton "Relancer")
  reminderDisabled   Boolean   @default(false)
  customReminderDays Int?

  lines            InvoiceLine[]
  paymentEvents    InvoicePaymentEvent[]
  transactions     InvoiceTransaction[]
  bankTransactions BankTransaction[]

  // ── FACTURATION ÉLECTRONIQUE (RÉFORME 2026/2027) ─────────
  einvoicingStatus         EInvoicingStatus?       @default(DRAFT)
  einvoicingProvider       EInvoicingProviderType?
  providerInvoiceId        String?
  einvoicingSentAt         DateTime?
  einvoicingProcessedAt    DateTime?
  einvoicingTransmissionId String?
  einvoicingError          String?
  einvoicingRawPayload     Json?

  einvoicingEvents EInvoicingEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([status])
  @@index([dueAt])
  @@index([stripePaymentIntentId])
  @@index([paymentToken])
  @@index([companyId, status])
  @@index([issuedAt]) // pour les rapports par période
}

// ============================================================
// INVOICE LINE
// ─────────────────────────────────────────────────────────────
// Une ligne dans la facture. Même logique que QuoteLine.
//
// RELATIONS:
// → Invoice (N:1) — appartient à une facture
// → CatalogItem (N:1) optionnel — article du catalogue
// ============================================================

model InvoiceLine {
  id        String  @id @default(cuid())
  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  catalogItemId String?
  catalogItem   CatalogItem? @relation(fields: [catalogItemId], references: [id])

  description String
  reference   String?
  quantity    Float    @default(1)
  unitPrice   Float
  tvaRate     Float    @default(20)
  unit        ItemUnit @default(UNITE)
  discount    Float    @default(0)
  total       Float

  position Int @default(0)

  createdAt DateTime @default(now())

  @@index([invoiceId])
  @@index([catalogItemId])
}

// ============================================================
// MESSAGE LOG (anciennement SmsLog)
// ─────────────────────────────────────────────────────────────
// Historique complet de tous les messages par client.
// SMS + Email + WhatsApp (V2) dans un seul historique unifié.
// Groupés par client pour former une conversation.
//
// RELATIONS:
// → Company (N:1)
// → Client (N:1) — conversation avec ce client
// ============================================================

model SmsLog {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  clientId  String
  client    Client  @relation(fields: [clientId], references: [id])

  direction   MessageDirection
  channel     PreferredChannel @default(SMS) // SMS, EMAIL, WHATSAPP
  body        String
  subject     String? // objet email si channel=EMAIL
  fromNumber  String? // null si channel=EMAIL
  toNumber    String? // null si channel=EMAIL
  fromEmail   String? // si channel=EMAIL
  toEmail     String? // si channel=EMAIL
  isRead      Boolean          @default(false)
  readAt      DateTime?
  deliveredAt DateTime?

  // Identifiants externes selon le provider
  twilioSid         String? @unique
  whatsappMessageId String? @unique
  emailMessageId    String? @unique
  externalMessageId String?
  status            String? // sent, delivered, read, failed, received

  // Connexion de canal associée (multi-tenant)
  whatsAppConnectionId String?
  whatsAppConnection   WhatsAppConnection? @relation(fields: [whatsAppConnectionId], references: [id], onDelete: SetNull)
  emailConnectionId    String?
  emailConnection      EmailConnection?    @relation(fields: [emailConnectionId], references: [id], onDelete: SetNull)

  // Threading Email
  threadId   String?
  inReplyTo  String?
  references String?

  // Pièces jointes (PDF factures, devis, fichiers...)
  attachments Json?

  // Type de message automatique envoyé par le système
  autoType     String? // "maintenance_reminder", "appointment_confirm", "manual", "bulk"
  templateName String?

  // Erreurs éventuelles
  errorCode    String?
  errorMessage String?
  metadata     Json?

  reminderExecutions ReminderExecution[]

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([companyId])
  @@index([clientId])
  @@index([clientId, createdAt]) // pour charger la conversation chronologiquement
  @@index([toNumber])
  @@index([fromNumber]) // pour trouver le client à la réception d'un SMS
  @@index([isRead])
  @@index([channel])
  @@index([threadId])
  @@index([externalMessageId])
}

// ============================================================
// WHATSAPP CONNECTION (MULTI-TENANT)
// ─────────────────────────────────────────────────────────────
// Connexion WhatsApp Business Cloud API par Company.
// Permet à chaque installateur d'utiliser son propre numéro.
// Supporte 1 ou N numéros par entreprise.
// ============================================================

model WhatsAppConnection {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  name                 String  @default("Principal") // "Général", "SAV"
  phoneNumberId        String // Phone Number ID Meta Graph API
  wabaId               String? // WhatsApp Business Account ID Meta
  displayPhoneNumber   String? // Ex: "+33 6 12 34 56 78"
  verifiedName         String? // Nom officiel vérifié par Meta
  qualityRating        String? // "GREEN", "YELLOW", "RED"
  encryptedAccessToken String? // Token d'accès chiffré AES-256-GCM

  status          String  @default("CONNECTED") // CONNECTED, ERROR, REAUTH_REQUIRED, DISCONNECTED
  isDefault       Boolean @default(true)
  webhookVerified Boolean @default(true)

  messages SmsLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, phoneNumberId])
  @@index([phoneNumberId])
  @@index([companyId])
}

// ============================================================
// EMAIL CONNECTION (MULTI-TENANT)
// ─────────────────────────────────────────────────────────────
// Connexion Email (Google Workspace, Microsoft 365, SMTP) par Company.
// ============================================================

model EmailConnection {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  provider          String // "GOOGLE", "MICROSOFT", "SMTP"
  emailAddress      String // "contact@climpro.fr"
  displayName       String? // "Dupont Climatisation"
  providerAccountId String? // ID du compte Google/Microsoft

  encryptedAccessToken  String? // OAuth Access Token chiffré AES-256-GCM
  encryptedRefreshToken String? // OAuth Refresh Token chiffré AES-256-GCM
  tokenExpiresAt        DateTime?

  smtpHost          String?
  smtpPort          Int?
  smtpUser          String?
  encryptedSmtpPass String? // Pass chiffré AES-256-GCM

  status     String    @default("CONNECTED") // CONNECTED, ERROR, REAUTH_REQUIRED, DISCONNECTED
  isDefault  Boolean   @default(true)
  lastSyncAt DateTime?

  messages SmsLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, emailAddress])
  @@index([companyId])
}

// ============================================================
// SMS USAGE
// ─────────────────────────────────────────────────────────────
// Compteur SMS mensuel par company.
// Reset automatique chaque 1er du mois (cron).
// Utilisé pour vérifier les limites du plan.
//
// RELATIONS:
// → Company (N:1)
// ============================================================

model SmsUsage {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  month     Int // 1-12
  year      Int
  count     Int   @default(0) // SMS envoyés ce mois
  extraCost Float @default(0) // coût SMS hors forfait

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, month, year])
}

// ============================================================
// NOTIFICATION
// ─────────────────────────────────────────────────────────────
// Toutes les notifications envoyées aux users.
// Un enregistrement par notification × canal.
//
// entityType + entityId permettent de naviguer vers
// l'élément concerné en cliquant sur la notif.
//
// RELATIONS:
// → Company (N:1)
// → User (N:1) — destinataire
// ============================================================

model Notification {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  type    NotificationType
  channel NotificationChannel
  status  NotificationStatus  @default(PENDING)

  title String
  body  String

  // Pour naviguer vers l'élément concerné
  entityType String? // "client", "intervention", "invoice", "quote", "sms"
  entityId   String?
  data       Json? // données supplémentaires

  isRead     Boolean   @default(false)
  readAt     DateTime?
  sentAt     DateTime?
  failedAt   DateTime?
  failReason String?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([userId, isRead])
  @@index([createdAt])
}

// ============================================================
// QUOTE REQUEST
// ─────────────────────────────────────────────────────────────
// Demandes de devis depuis le formulaire public sur le site
// de l'installateur. Pas besoin de compte client.
//
// RELATIONS:
// → Company (N:1) — destinataire de la demande
// ============================================================

model QuoteRequest {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  firstName   String
  lastName    String
  phone       String
  email       String?
  address     String?
  tradeSlug   String? // "climatisation", "pompe-a-chaleur"...
  message     String?
  isProcessed Boolean   @default(false)
  processedAt DateTime?

  createdAt DateTime @default(now())

  @@index([companyId])
  @@index([isProcessed])
}

// ============================================================
// ACCOUNTING EXPORT
// ─────────────────────────────────────────────────────────────
// Exports comptables générés par la company.
// Chaque export = un fichier Excel/CSV téléchargeable
// contenant toutes les factures d'une période.
//
// Utilisé par:
//   - Le comptable de l'installateur
//   - L'installateur lui-même pour la déclaration TVA
//   - L'intégration Pennylane/Indy (si activée)
//
// RELATIONS:
// → Company (N:1)
// ============================================================

model AccountingExport {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  // Période couverte
  periodStart DateTime
  periodEnd   DateTime
  periodLabel String // "T1 2026", "Janvier 2026", "2026"
  type        AccountingExportType

  // Fichier généré
  fileUrl  String? // URL du fichier Excel/CSV sur Cloudinary
  fileName String? // "export-comptable-T1-2026.xlsx"

  // Totaux calculés (snapshot au moment de l'export)
  totalHT      Float @default(0)
  totalTva0    Float @default(0) // TVA 0%
  totalTva55   Float @default(0) // TVA 5.5%
  totalTva10   Float @default(0) // TVA 10%
  totalTva20   Float @default(0) // TVA 20%
  totalTvaAll  Float @default(0) // Total TVA collectée
  totalTTC     Float @default(0)
  invoiceCount Int   @default(0) // nb factures incluses
  paidCount    Int   @default(0) // nb factures payées

  // Intégration externe
  pennylaneExportedAt DateTime? // si envoyé vers Pennylane
  indyExportedAt      DateTime? // si envoyé vers Indy

  createdAt DateTime @default(now())

  @@index([companyId])
  @@index([companyId, periodStart])
}

// ============================================================
// TVA SUMMARY
// ─────────────────────────────────────────────────────────────
// Résumé TVA calculé automatiquement chaque trimestre.
// Affiché dans l'interface pour aider l'installateur
// à remplir sa déclaration sur impots.gouv.fr
//
// RELATIONS:
// → Company (N:1)
// ============================================================

model TvaSummary {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  // Trimestre: Q1=1, Q2=2, Q3=3, Q4=4
  quarter Int
  year    Int

  // Montants TVA collectée (sur factures payées)
  caHT     Float @default(0) // chiffre d'affaires HT
  tva0     Float @default(0)
  tva55    Float @default(0)
  tva10    Float @default(0)
  tva20    Float @default(0)
  totalTva Float @default(0) // total TVA à déclarer

  // Statut déclaration
  isDeclared Boolean   @default(false)
  declaredAt DateTime?
  declaredBy String? // userId

  // Dates du trimestre
  periodStart DateTime
  periodEnd   DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, quarter, year])
  @@index([companyId])
}

// ============================================================
// ACCOUNTING INTEGRATION
// ─────────────────────────────────────────────────────────────
// Connexion avec logiciels comptables tiers (Pennylane, Indy)
// Chaque company peut connecter un logiciel comptable.
// Les factures sont envoyées automatiquement après création/paiement.
//
// RELATIONS:
// → Company (1:1)
// ============================================================

model AccountingIntegration {
  id        String  @id @default(cuid())
  companyId String  @unique
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  provider AccountingProvider // PENNYLANE, INDY, QUICKBOOKS, NONE

  // Credentials chiffrées (AES-256)
  apiKey         String? // clé API chiffrée
  apiSecret      String? // secret chiffré
  organizationId String? // ID organisation chez le provider

  isActive      Boolean   @default(true)
  lastSyncAt    DateTime?
  lastSyncError String?

  // Mapping: quand envoyer automatiquement
  syncOnCreate Boolean @default(false) // à la création de la facture
  syncOnSend   Boolean @default(true) // à l'envoi au client
  syncOnPaid   Boolean @default(true) // au paiement

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ============================================================
// INVOICE PAYMENT EVENT
// ─────────────────────────────────────────────────────────────
// Historique des événements de paiement en ligne pour chaque facture.
// Créé automatiquement via webhook Stripe.
//
// Permet de tracer tout le cycle de paiement:
//   checkout.created → link_opened → payment_succeeded/failed
//
// RELATIONS:
// → Invoice (N:1) — appartient à une facture
// ============================================================

model InvoicePaymentEvent {
  id        String  @id @default(cuid())
  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  // Type d'événement Stripe
  event String // "checkout.created", "checkout.expired",
  // "payment.succeeded", "payment.failed",
  // "payment.refunded"

  amount   Float? // montant concerné
  currency String @default("EUR")

  // Données Stripe brutes
  stripeEventId String? @unique
  stripeData    Json?

  // IP du client au moment du paiement
  clientIp String?

  createdAt DateTime @default(now())

  @@index([invoiceId])
}

// ============================================================
// AUDIT LOG
// ─────────────────────────────────────────────────────────────
// Historique de toutes les actions importantes.
// Permet de savoir qui a fait quoi et quand.
// Conservé pendant 1 an puis archivé.
//
// RELATIONS:
// → Company (N:1)
// → User (N:1) optionnel — qui a fait l'action
// ============================================================

model AuditLog {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?   @relation(fields: [userId], references: [id])

  action     String // "client.created", "invoice.paid", "intervention.completed"
  entityType String // "Client", "Invoice", "Intervention"
  entityId   String
  oldData    Json? // état avant modification
  newData    Json? // état après modification
  ipAddress  String?

  createdAt DateTime @default(now())

  @@index([companyId])
  @@index([entityType, entityId])
  @@index([createdAt])
}

// ============================================================
// SUPER ADMIN
// ─────────────────────────────────────────────────────────────
// Rôle système pour le créateur de la plateforme.
// Complètement séparé des Company/User normaux.
// Accès à /admin/* uniquement.
//
// SystemRole:
//   SUPER_ADMIN → accès total: stats, impersonate, bloquer
//   SUPPORT     → lecture seule: voir companies, aider clients
//
// RELATIONS:
// → AdminSession (1:N) — sessions actives
// → AdminAuditLog (1:N) — toutes ses actions
// ============================================================

model AdminUser {
  id          String     @id @default(cuid())
  email       String     @unique
  password    String // bcrypt hash
  firstName   String
  lastName    String
  systemRole  SystemRole @default(SUPPORT)
  isActive    Boolean    @default(true)
  lastLoginAt DateTime?

  refreshTokenHash String?

  sessions  AdminSession[]
  auditLogs AdminAuditLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ============================================================
// ADMIN SESSION
// Sessions actives des admins (refresh tokens)
// ============================================================

model AdminSession {
  id          String    @id @default(cuid())
  adminUserId String
  adminUser   AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)

  refreshTokenHash String
  device           String?
  ipAddress        String?
  expiresAt        DateTime
  lastUsedAt       DateTime @default(now())

  createdAt DateTime @default(now())
}

// ============================================================
// ADMIN AUDIT LOG
// Toutes les actions des admins (qui a fait quoi sur quelle company)
// ============================================================

model AdminAuditLog {
  id          String    @id @default(cuid())
  adminUserId String
  adminUser   AdminUser @relation(fields: [adminUserId], references: [id])

  action     String // "company.blocked", "company.impersonated", "plan.changed"
  targetType String // "Company", "Subscription", "User"
  targetId   String
  details    Json?
  ipAddress  String?

  createdAt DateTime @default(now())

  @@index([adminUserId])
  @@index([targetType, targetId])
}

// ============================================================
// FACTURATION ÉLECTRONIQUE (RÉFORME FR 2026 / 2027)
// ============================================================

// ── CONNEXION PLATEFORME AGRÉÉE ──────────────────────────────
model EInvoicingConnection {
  id        String  @id @default(cuid())
  companyId String  @unique
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  provider          EInvoicingProviderType     @default(B2BROUTER)
  providerAccountId String? // Account ID chez le provider (ex: B2Brouter project/account ID)
  environment       String                     @default("sandbox") // "sandbox" | "production"
  status            EInvoicingConnectionStatus @default(DISCONNECTED)

  // Credentials chiffrées (AES-256-GCM) — JAMAIS stockées en clair
  apiKeyEncrypted       String?
  apiSecretEncrypted    String?
  accessTokenEncrypted  String?
  refreshTokenEncrypted String?
  tokenExpiresAt        DateTime?

  // Paramètres fonctionnels
  receivingEnabled Boolean @default(true) // Obligatoire à partir du 1er sept 2026
  emissionEnabled  Boolean @default(false) // B2B outgoing (généralisé 2027)
  autoSyncIncoming Boolean @default(true)

  lastSyncAt    DateTime?
  lastSyncError String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([status])
}

// ── FACTURES FOURNISSEURS REÇUES (INCOMING E-INVOICES) ────────
model ReceivedInvoice {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  provider          EInvoicingProviderType @default(B2BROUTER)
  providerInvoiceId String // ID facture chez le provider

  // Fournisseur (Émetteur)
  supplierName       String
  supplierSiren      String?
  supplierSiret      String?
  supplierVatNumber  String?
  supplierAddress    String?
  supplierCity       String?
  supplierPostalCode String?
  supplierCountry    String? @default("FR")
  supplierEmail      String?

  // Facture
  invoiceNumber String
  issueDate     DateTime
  dueDate       DateTime?
  currency      String    @default("EUR")

  // Montants
  totalHT  Float
  totalVAT Float
  totalTTC Float

  // Statut
  status EInvoicingStatus @default(RECEIVED) // RECEIVED, ACCEPTED, REJECTED, PAID, CANCELLED

  // Données structurées et document PDF / Factur-X
  structuredData Json? // Données sémantiques normalisées EN 16931 / UBL / CII
  documentUrl    String? // URL document téléchargeable (PDF / XML / Factur-X)
  rawFormat      String? // "Factur-X", "UBL", "CII", "JSON"

  receivedAt DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  events EInvoicingEvent[]

  @@unique([companyId, provider, providerInvoiceId])
  @@index([companyId])
  @@index([status])
  @@index([issueDate])
  @@index([supplierSiret])
}

// ── JOURNAL D'ÉVÉNEMENTS & WEBHOOKS FACTURATION ÉLECTRONIQUE ───
model EInvoicingEvent {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  invoiceId         String?
  invoice           Invoice?         @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  receivedInvoiceId String?
  receivedInvoice   ReceivedInvoice? @relation(fields: [receivedInvoiceId], references: [id], onDelete: Cascade)

  provider          String // "B2BROUTER", etc.
  providerInvoiceId String?
  eventType         String // "invoice.received", "invoice.status_changed", "invoice.rejected", "payment.recorded"
  providerStatus    String?

  idempotencyKey String? @unique // Pour idempotence des webhooks
  payloadJson    Json?
  errorMessage   String?

  receivedAt  DateTime  @default(now())
  processedAt DateTime?

  createdAt DateTime @default(now())

  @@index([companyId])
  @@index([invoiceId])
  @@index([receivedInvoiceId])
  @@index([eventType])
}

// ── FILE DE TÂCHES ASYNCHRONES PERSISTANTE (JOB QUEUE) ────────
model EInvoicingJob {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  type    EInvoicingJobType
  payload Json
  status  EInvoicingJobStatus @default(PENDING) // PENDING, PROCESSING, COMPLETED, FAILED

  attempts    Int       @default(0)
  maxAttempts Int       @default(5)
  nextRunAt   DateTime  @default(now())
  lockedAt    DateTime?
  lockedBy    String?
  lastError   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, nextRunAt])
  @@index([companyId])
}

// ============================================================
// INVOICE TRANSACTION (Factures)
// ─────────────────────────────────────────────────────────────
// Historique des transactions de règlement pour les factures.
// ============================================================

model InvoiceTransaction {
  id        String  @id @default(cuid())
  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  type     InvoicePaymentMethodType
  status   String                   @default("succeeded") // succeeded, failed, pending
  amount   Float
  currency String                   @default("EUR")

  stripePaymentIntentId   String? @unique
  stripeCheckoutSessionId String? @unique
  stripeTransferId        String?
  bankReference           String?

  paidAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([invoiceId])
  @@index([companyId])
  @@index([stripePaymentIntentId])
  @@index([stripeCheckoutSessionId])
}

// ============================================================
// STRIPE FEE CONFIG
// ─────────────────────────────────────────────────────────────
// Tarification Stripe dynamique et configurable.
// ============================================================

model StripeFeeConfig {
  id       String  @id @default(cuid())
  feeRate  Float   @default(0.015) // 1.5%
  fixedFee Float   @default(0.25) // 0.25€
  currency String  @default("EUR")
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ============================================================
// OPEN BANKING — CONNEXION BANCAIRE (POWENS / GOCARDLESS)
// ============================================================

model BankConnection {
  id        String  @id @default(cuid())
  companyId String  @unique
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  provider     String // "POWENS", "GOCARDLESS"
  connectionId String
  userId       String?

  accessTokenEncrypted  String?
  refreshTokenEncrypted String?
  tokenExpiresAt        DateTime?
  status                String    @default("PENDING") // PENDING, ACTIVE, ERROR, DISCONNECTED
  lastSyncAt            DateTime?

  accounts BankAccount[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
}

model BankAccount {
  id               String         @id @default(cuid())
  bankConnectionId String
  bankConnection   BankConnection @relation(fields: [bankConnectionId], references: [id], onDelete: Cascade)
  companyId        String
  company          Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)

  externalId  String
  iban        String?
  bic         String?
  accountName String?
  balance     Float?
  currency    String  @default("EUR")

  transactions BankTransaction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
}

model BankTransaction {
  id            String      @id @default(cuid())
  bankAccountId String
  bankAccount   BankAccount @relation(fields: [bankAccountId], references: [id], onDelete: Cascade)
  companyId     String
  company       Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)

  externalTransactionId String    @unique
  amount                Float
  currency              String    @default("EUR")
  label                 String?
  reference             String?
  counterparty          String?
  counterpartyIban      String?
  transactionDate       DateTime
  valueDate             DateTime?

  reconciliationStatus String?   @default("PENDING") // MATCHED, PROBABLE, IGNORED, PENDING
  confidenceScore      Float? // 0.0 → 1.0
  matchedInvoiceId     String?
  matchedInvoice       Invoice?  @relation(fields: [matchedInvoiceId], references: [id], onDelete: SetNull)
  reconciledAt         DateTime?
  reconciledBy         String? // "AUTO" | userId

  createdAt DateTime @default(now())

  @@index([companyId])
  @@index([externalTransactionId])
  @@index([matchedInvoiceId])
}

// ============================================================
// AUTO RAPPEL & MULTI-SERVICES MODELS (PREMIUM)
// ============================================================

// ── SERVICE TYPE ────────────────────────────────────────────
// Types de services/prestations réalisés chez le client.
// Multi-tenant : chaque company a ses types par défaut + personnalisés.
model ServiceType {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  tradeSlug   String? // "climatisation-pac", "electricien", "plombier", "chauffagiste"
  name        String // "Entretien annuel", "Nettoyage", "Ramonage", "Dépannage"
  category    String? // "maintenance", "cleaning", "repair", "control", "followup"
  description String?

  // Valeurs par défaut suggérées
  defaultFrequencyValue     Int?                   @default(12)
  defaultFrequencyUnit      TimeUnit?              @default(MONTHS)
  defaultAdvanceNoticeValue Int?                   @default(30)
  defaultAdvanceNoticeUnit  TimeUnit?              @default(DAYS)
  defaultChannel            ReminderChannelChoice? @default(LAST_USED)
  defaultTemplate           String?
  recommendationLevel       RecommendationLevel    @default(RECOMMENDED) // RECOMMENDED, OPTIONAL, CUSTOMIZABLE

  isDefault Boolean @default(false) // Types système par défaut
  isActive  Boolean @default(true) // Soft delete / archive
  sortOrder Int     @default(0)

  interventionServices InterventionService[]
  automationMappings   ReminderAutomationService[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, name])
  @@index([companyId])
  @@index([companyId, isActive])
}

// ── INTERVENTION SERVICE (MULTI-SERVICES PER VISIT) ─────────
// Associe une intervention à un ou plusieurs services réalisés.
model InterventionService {
  id             String       @id @default(cuid())
  interventionId String
  intervention   Intervention @relation(fields: [interventionId], references: [id], onDelete: Cascade)
  serviceTypeId  String
  serviceType    ServiceType  @relation(fields: [serviceTypeId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([interventionId, serviceTypeId])
  @@index([interventionId])
  @@index([serviceTypeId])
}

// ── REMINDER AUTOMATION (RÈGLE DE RAPPEL AUTOMATIQUE) ───────
// Règle active de rappel pour un client et un cycle de service donné.
model ReminderAutomation {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  name             String // "Rappel Entretien Climatisation", "Relance Dépannage +7j"
  automationType   AutomationType @default(PERIODIC) // PERIODIC ou FOLLOW_UP
  enabled          Boolean        @default(true)
  isCustomOverride Boolean        @default(false) // Si configuré manuellement pour un client spécifique (ne pas écraser lors des règles globales)

  // Configuration Fréquence
  frequencyValue Int      @default(12)
  frequencyUnit  TimeUnit @default(MONTHS)

  // Configuration Préavis d'envoi
  advanceNoticeValue Int      @default(30)
  advanceNoticeUnit  TimeUnit @default(DAYS)

  // Canaux
  channel         ReminderChannelChoice @default(LAST_USED)
  fallbackChannel PreferredChannel?     @default(SMS)

  // Modèle de message personnalisé (variables {{client_first_name}}, etc.)
  customMessageTemplate String?

  // Conditions d'arrêt intelligentes
  stopOnReply          Boolean @default(true)
  stopOnAppointment    Boolean @default(true)
  maxFollowUps         Int     @default(2)
  followUpIntervalDays Int     @default(7)

  // Statut & Planification
  status         ReminderStatus @default(SCHEDULED)
  nextReminderAt DateTime?

  // Traçabilité de l'événement déclencheur
  lastCompletedInterventionId String?
  lastCompletedIntervention   Intervention? @relation("LastCompletedIntervention", fields: [lastCompletedInterventionId], references: [id], onDelete: SetNull)
  lastCompletedAt             DateTime?

  // Services suivis par ce rappel
  trackedServices ReminderAutomationService[]
  executions      ReminderExecution[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([clientId])
  @@index([status])
  @@index([nextReminderAt])
  @@index([companyId, enabled, status])
}

// ── REMINDER AUTOMATION SERVICE MAPPING ─────────────────────
// Lie un ReminderAutomation aux ServiceTypes qui le réinitialisent.
model ReminderAutomationService {
  id                   String             @id @default(cuid())
  reminderAutomationId String
  reminderAutomation   ReminderAutomation @relation(fields: [reminderAutomationId], references: [id], onDelete: Cascade)
  serviceTypeId        String
  serviceType          ServiceType        @relation(fields: [serviceTypeId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([reminderAutomationId, serviceTypeId])
  @@index([reminderAutomationId])
  @@index([serviceTypeId])
}

// ── REMINDER EXECUTION (HISTORIQUE ET ÉTATS D'EXÉCUTION) ─────
// Enregistre chaque tentative d'envoi, relance et réponse client.
model ReminderExecution {
  id                   String             @id @default(cuid())
  companyId            String
  company              Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  reminderAutomationId String
  reminderAutomation   ReminderAutomation @relation(fields: [reminderAutomationId], references: [id], onDelete: Cascade)
  clientId             String
  client               Client             @relation(fields: [clientId], references: [id], onDelete: Cascade)
  interventionId       String?
  intervention         Intervention?      @relation(fields: [interventionId], references: [id], onDelete: SetNull)

  sequenceStep Int       @default(1) // 1 = 1er message, 2 = 1ère relance, 3 = 2ème relance
  scheduledAt  DateTime
  executedAt   DateTime?

  channel PreferredChannel? // SMS, WHATSAPP, EMAIL
  status  ReminderExecutionStatus @default(SCHEDULED)

  messageId String? // Référence vers SmsLog
  message   SmsLog? @relation(fields: [messageId], references: [id], onDelete: SetNull)

  recipient       String? // Numéro de téléphone ou email
  renderedContent String? // Message final avec variables remplacées
  error           String? // Message d'erreur clair si échec
  respondedAt     DateTime? // Horodatage si le client a répondu

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([reminderAutomationId])
  @@index([clientId])
  @@index([status, scheduledAt])
  @@index([companyId, status])
}
