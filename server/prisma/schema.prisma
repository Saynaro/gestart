generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Plan {
  id                    String         @id @default(cuid())
  name                  PlanName       @unique
  displayName           String
  priceMonthly          Float
  priceAnnual           Float
  maxClients            Int
  maxTechnicians        Int
  maxSmsPerMonth        Int
  extraSmsCost          Float          @default(0.10)
  hasMobileApp          Boolean        @default(false)
  hasAutoSmsReminders   Boolean        @default(false)
  hasAdvancedReports    Boolean        @default(false)
  hasChorusPro          Boolean        @default(false)
  hasDedicatedSmsNumber Boolean        @default(false)
  hasAccountManager     Boolean        @default(false)
  hasPrioritySupport    Boolean        @default(false)
  hasPremiumSettings    Boolean        @default(false)
  stripeMonthlyPriceId  String?
  stripeAnnualPriceId   String?
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt
  subscriptions         Subscription[]
}

model Company {
  id                    String                 @id @default(cuid())
  name                  String
  siret                 String?                @unique
  siren                 String?                @unique
  tvaNumber             String?
  legalForm             String?
  rcsNumber             String?
  shareCapital          String?
  nafCode               String?
  isTvaFranchise        Boolean                @default(false)
  isSubcontractor       Boolean                @default(false)
  phone                 String?
  email                 String?
  address               String?
  city                  String?
  postalCode            String?
  logoUrl               String?
  website               String?
  slug                  String?                @unique
  smsNumber             String?
  stripeAccountId       String?                @unique
  stripeAccountStatus   String?
  onlinePaymentEnabled  Boolean                @default(false)
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  accountingExports     AccountingExport[]
  accountingIntegration AccountingIntegration?
  auditLogs             AuditLog[]
  catalogItems          CatalogItem[]
  clients               Client[]
  settings              CompanySettings?
  tradeCategories       CompanyTradeCategory[]
  interventions         Intervention[]
  interventionTypes     InterventionTypeItem[]
  invitations           Invitation[]
  invoices              Invoice[]
  notifications         Notification[]
  quotes                Quote[]
  quoteRequests         QuoteRequest[]
  smsLogs               SmsLog[]
  smsUsage              SmsUsage[]
  subscription          Subscription?
  tvaSummaries          TvaSummary[]
  users                 User[]
}

model CompanyTradeCategory {
  id              String        @id @default(cuid())
  companyId       String
  tradeCategoryId String
  createdAt       DateTime      @default(now())
  company         Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  tradeCategory   TradeCategory @relation(fields: [tradeCategoryId], references: [id])

  @@unique([companyId, tradeCategoryId])
}

model TradeCategory {
  id          String                 @id @default(cuid())
  name        String                 @unique
  slug        String                 @unique
  description String?
  icon        String?
  isActive    Boolean                @default(true)
  sortOrder   Int                    @default(0)
  createdAt   DateTime               @default(now())
  companies   CompanyTradeCategory[]
}

model Subscription {
  id                   String           @id @default(cuid())
  companyId            String           @unique
  planId               String
  status               PlanStatus       @default(TRIALING)
  cycle                PlanBillingCycle @default(MONTHLY)
  trialEndsAt          DateTime?
  currentPeriodStart   DateTime?
  currentPeriodEnd     DateTime?
  cancelledAt          DateTime?
  stripeCustomerId     String?          @unique
  stripeSubscriptionId String?          @unique
  smsUsedThisMonth     Int              @default(0)
  smsResetAt           DateTime?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt
  payments             Payment[]
  company              Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  plan                 Plan             @relation(fields: [planId], references: [id])
}

model Payment {
  id                    String         @id @default(cuid())
  subscriptionId        String
  amount                Float
  currency              String         @default("EUR")
  status                String
  method                PaymentMethod?
  stripePaymentIntentId String?        @unique
  stripeInvoiceUrl      String?
  paidAt                DateTime?
  createdAt             DateTime       @default(now())
  subscription          Subscription   @relation(fields: [subscriptionId], references: [id])
}

model CompanySettings {
  id                       String                @id @default(cuid())
  companyId                String                @unique
  defaultChannelReminder   PreferredChannel      @default(SMS)
  defaultChannelQuote      PreferredChannel      @default(EMAIL)
  defaultChannelInvoice    PreferredChannel      @default(EMAIL)
  defaultChannelConfirm    PreferredChannel      @default(SMS)
  smsReminderEnabled       Boolean               @default(true)
  smsDaysBefore            Int                   @default(30)
  smsSecondReminderEnabled Boolean               @default(false)
  smsSecondReminderDays    Int                   @default(7)
  smsReminderTemplate      String?
  smsSignature             String?
  notifyNewClient          Boolean               @default(true)
  notifyNewMessage         Boolean               @default(true)
  notifyInterventionDone   Boolean               @default(true)
  notifyInvoicePaid        Boolean               @default(true)
  notifyUrgentMaintenance  Boolean               @default(true)
  notifyQuoteRequest       Boolean               @default(true)
  notifyPlanExpiring       Boolean               @default(true)
  notifySmsLimit           Boolean               @default(true)
  notifyTechAssigned       Boolean               @default(true)
  notifyTechUpdated        Boolean               @default(true)
  notifyTechCancelled      Boolean               @default(true)
  notifyTechReminder24h    Boolean               @default(true)
  notifyTechReminder1h     Boolean               @default(true)
  ownerChannels            NotificationChannel[] @default([PUSH, IN_APP])
  techChannels             NotificationChannel[] @default([PUSH, IN_APP])
  invoicePrefix            String                @default("INV")
  invoiceNextNumber        Int                   @default(1)
  quotePrefix              String                @default("D")
  quoteNextNumber          Int                   @default(1)
  invoiceFooter            String?
  invoiceConditions        String?
  defaultTvaRate           Float                 @default(20)
  defaultPaymentDays       Int                   @default(30)
  defaultValidDays         Int                   @default(30)
  workStartHour            Int                   @default(8)
  workEndHour              Int                   @default(18)
  workDays                 Int[]                 @default([1, 2, 3, 4, 5])
  createdAt                DateTime              @default(now())
  updatedAt                DateTime              @updatedAt
  company                  Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
}

model User {
  id                   String         @id @default(cuid())
  companyId            String
  email                String         @unique
  password             String
  firstName            String
  lastName             String
  phone                String?
  avatarUrl            String?
  role                 UserRole       @default(TECHNICIAN)
  isActive             Boolean        @default(true)
  refreshTokenHash     String?
  emailVerified        Boolean        @default(false)
  emailVerifyToken     String?
  passwordResetToken   String?
  passwordResetExpiry  DateTime?
  lastLoginAt          DateTime?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
  auditLogs            AuditLog[]
  createdClients       Client[]       @relation("ClientCreatedBy")
  createdInterventions Intervention[] @relation("InterventionCreatedBy")
  interventions        Intervention[] @relation("TechnicianInterventions")
  notifications        Notification[]
  pushTokens           PushToken[]
  company              Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
}

model PushToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  device    String?
  platform  String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Invitation {
  id          String           @id @default(cuid())
  companyId   String
  email       String
  role        UserRole         @default(TECHNICIAN)
  token       String           @unique @default(cuid())
  status      InvitationStatus @default(PENDING)
  invitedById String?
  expiresAt   DateTime
  acceptedAt  DateTime?
  revokedAt   DateTime?
  createdAt   DateTime         @default(now())
  company     Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, email])
}

model CatalogItem {
  id           String          @id @default(cuid())
  companyId    String
  name         String
  description  String?
  reference    String?
  type         CatalogItemType
  defaultPrice Float
  tvaRate      Float           @default(20)
  unit         ItemUnit        @default(UNITE)
  isActive     Boolean         @default(true)
  isFavorite   Boolean         @default(false)
  usageCount   Int             @default(0)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  company      Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  invoiceLines InvoiceLine[]
  quoteLines   QuoteLine[]

  @@index([companyId])
  @@index([companyId, isActive])
  @@index([companyId, usageCount])
}

model InterventionTypeItem {
  id            String         @id @default(cuid())
  companyId     String
  name          String
  isDefault     Boolean        @default(false)
  isActive      Boolean        @default(true)
  usageCount    Int            @default(0)
  sortOrder     Int            @default(0)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  interventions Intervention[]
  company       Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  invoices      Invoice[]
  quotes        Quote[]

  @@unique([companyId, name])
  @@index([companyId])
}

model Client {
  id                 String            @id @default(cuid())
  companyId          String
  createdById        String?
  firstName          String
  lastName           String
  companyName        String?
  phone              String
  email              String?
  address            String
  city               String?
  postalCode         String?
  notes              String?
  isActive           Boolean           @default(true)
  status             ClientStatus      @default(OK)
  source             String?
  preferredChannel   PreferredChannel  @default(SMS)
  channelForReminder PreferredChannel?
  channelForQuote    PreferredChannel?
  channelForInvoice  PreferredChannel?
  channelForConfirm  PreferredChannel?
  sirenNumber        String?
  clientTvaNumber    String?
  clientLegalForm    String?
  clientNafCode      String?
  hasDeliveryAddress Boolean           @default(false)
  deliveryAddress    String?
  deliveryCity       String?
  deliveryPostalCode String?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  company            Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdBy          User?             @relation("ClientCreatedBy", fields: [createdById], references: [id])
  equipment          Equipment[]
  interventions      Intervention[]
  invoices           Invoice[]
  quotes             Quote[]
  smsLogs            SmsLog[]

  @@index([companyId])
  @@index([companyId, status])
  @@index([phone])
}

model Equipment {
  id              String         @id @default(cuid())
  clientId        String
  brand           String
  model           String?
  serialNumber    String?
  power           String?
  location        String?
  tradeSlug       String?
  installDate     DateTime?
  warrantyExpiry  DateTime?
  lastServiceDate DateTime?
  nextServiceDate DateTime?
  serviceInterval Int            @default(12)
  isActive        Boolean        @default(true)
  notes           String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  client          Client         @relation(fields: [clientId], references: [id], onDelete: Cascade)
  interventions   Intervention[]

  @@index([clientId])
  @@index([nextServiceDate])
}

model Intervention {
  id                 String                @id @default(cuid())
  companyId          String
  clientId           String
  equipmentId        String?
  technicianId       String?
  createdById        String?
  interventionTypeId String?
  status             InterventionStatus    @default(PENDING)
  scheduledAt        DateTime?
  estimatedDuration  Int?
  startedAt          DateTime?
  completedAt        DateTime?
  title              String
  description        String?
  address            String
  city               String?
  accessCode         String?
  techNotes          String?
  materialsUsed      String?
  clientSignature    String?
  clientSignedAt     DateTime?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  client             Client                @relation(fields: [clientId], references: [id])
  company            Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdBy          User?                 @relation("InterventionCreatedBy", fields: [createdById], references: [id])
  equipment          Equipment?            @relation(fields: [equipmentId], references: [id])
  interventionType   InterventionTypeItem? @relation(fields: [interventionTypeId], references: [id])
  technician         User?                 @relation("TechnicianInterventions", fields: [technicianId], references: [id])
  photos             InterventionPhoto[]
  invoice            Invoice?
  quote              Quote?

  @@index([companyId])
  @@index([technicianId])
  @@index([scheduledAt])
  @@index([status])
  @@index([companyId, status])
}

model InterventionPhoto {
  id             String       @id @default(cuid())
  interventionId String
  url            String
  type           String       @default("after")
  caption        String?
  createdAt      DateTime     @default(now())
  intervention   Intervention @relation(fields: [interventionId], references: [id], onDelete: Cascade)
}

model Quote {
  id                   String                @id @default(cuid())
  companyId            String
  clientId             String
  interventionId       String?               @unique
  interventionTypeId   String?
  number               String
  status               QuoteStatus           @default(DRAFT)
  amountHT             Float
  tvaRate              Float                 @default(20)
  amountTTC            Float
  subject              String?
  notes                String?
  conditions           String?
  validUntil           DateTime?
  acceptedAt           DateTime?
  refusedAt            DateTime?
  serviceDate          DateTime?
  operationType        String?               @default("services")
  depositPercent       Float?
  depositAmount        Float?
  paymentConditions    String?
  signatureToken       String?               @unique
  signatureTokenExpiry DateTime?
  signedAt             DateTime?
  signatureUrl         String?
  signatureIp          String?
  emailSentAt          DateTime?
  emailSentTo          String?
  reminder1SentAt      DateTime?
  reminder2SentAt      DateTime?
  issuedAt             DateTime              @default(now())
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  client               Client                @relation(fields: [clientId], references: [id])
  company              Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  intervention         Intervention?         @relation(fields: [interventionId], references: [id])
  interventionType     InterventionTypeItem? @relation(fields: [interventionTypeId], references: [id])
  lines                QuoteLine[]

  @@index([companyId])
  @@index([clientId])
  @@index([status])
}

model QuoteLine {
  id            String       @id @default(cuid())
  quoteId       String
  catalogItemId String?
  description   String
  reference     String?
  quantity      Float        @default(1)
  unitPrice     Float
  tvaRate       Float        @default(20)
  unit          ItemUnit     @default(UNITE)
  discount      Float        @default(0)
  total         Float
  position      Int          @default(0)
  createdAt     DateTime     @default(now())
  catalogItem   CatalogItem? @relation(fields: [catalogItemId], references: [id])
  quote         Quote        @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@index([quoteId])
  @@index([catalogItemId])
}

model Invoice {
  id                      String                @id @default(cuid())
  companyId               String
  clientId                String
  interventionId          String?               @unique
  sourceQuoteId           String?               @unique
  interventionTypeId      String?
  number                  String
  status                  InvoiceStatus         @default(DRAFT)
  amountHT                Float
  tvaRate                 Float                 @default(20)
  amountTTC               Float
  amountPaid              Float                 @default(0)
  serviceDate             DateTime?
  operationType           String?               @default("services")
  penaltyRate             Float                 @default(10)
  recoveryFee             Float                 @default(40)
  discountTerms           String?               @default("Aucun escompte pour paiement anticipé")
  tvaOnDebit              Boolean               @default(false)
  isTvaFranchise          Boolean               @default(false)
  isAutoLiquidation       Boolean               @default(false)
  orderNumber             String?
  workDescription         String?
  subject                 String?
  notes                   String?
  conditions              String?
  paymentMethod           PaymentMethod?
  paymentRef              String?
  pdfUrl                  String?
  onlinePaymentEnabled    Boolean               @default(false)
  stripePaymentIntentId   String?               @unique
  stripeCheckoutUrl       String?
  stripeCheckoutSessionId String?               @unique
  paymentToken            String?               @unique
  paymentTokenExpiry      DateTime?
  paymentLinkOpenedAt     DateTime?
  issuedAt                DateTime              @default(now())
  dueAt                   DateTime?
  paidAt                  DateTime?
  emailSentAt             DateTime?
  emailSentTo             String?
  reminder1SentAt         DateTime?
  reminder2SentAt         DateTime?
  reminderSentAt          DateTime?
  createdAt               DateTime              @default(now())
  updatedAt               DateTime              @updatedAt
  client                  Client                @relation(fields: [clientId], references: [id])
  company                 Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  intervention            Intervention?         @relation(fields: [interventionId], references: [id])
  interventionType        InterventionTypeItem? @relation(fields: [interventionTypeId], references: [id])
  lines                   InvoiceLine[]
  paymentEvents           InvoicePaymentEvent[]

  @@index([companyId])
  @@index([status])
  @@index([dueAt])
  @@index([stripePaymentIntentId])
  @@index([paymentToken])
  @@index([companyId, status])
  @@index([issuedAt])
}

model InvoiceLine {
  id            String       @id @default(cuid())
  invoiceId     String
  catalogItemId String?
  description   String
  reference     String?
  quantity      Float        @default(1)
  unitPrice     Float
  tvaRate       Float        @default(20)
  unit          ItemUnit     @default(UNITE)
  discount      Float        @default(0)
  total         Float
  position      Int          @default(0)
  createdAt     DateTime     @default(now())
  catalogItem   CatalogItem? @relation(fields: [catalogItemId], references: [id])
  invoice       Invoice      @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@index([catalogItemId])
}

model SmsLog {
  id         String           @id @default(cuid())
  companyId  String
  clientId   String
  direction  MessageDirection
  channel    PreferredChannel @default(SMS)
  body       String
  subject    String?
  fromNumber String?
  toNumber   String?
  fromEmail  String?
  toEmail    String?
  isRead     Boolean          @default(false)
  readAt     DateTime?
  twilioSid  String?          @unique
  status     String?
  autoType   String?
  createdAt  DateTime         @default(now())
  client     Client           @relation(fields: [clientId], references: [id])
  company    Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([clientId])
  @@index([clientId, createdAt])
  @@index([toNumber])
  @@index([fromNumber])
  @@index([isRead])
}

model SmsUsage {
  id        String   @id @default(cuid())
  companyId String
  month     Int
  year      Int
  count     Int      @default(0)
  extraCost Float    @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, month, year])
}

model Notification {
  id         String              @id @default(cuid())
  companyId  String
  userId     String
  type       NotificationType
  channel    NotificationChannel
  status     NotificationStatus  @default(PENDING)
  title      String
  body       String
  entityType String?
  entityId   String?
  data       Json?
  isRead     Boolean             @default(false)
  readAt     DateTime?
  sentAt     DateTime?
  failedAt   DateTime?
  failReason String?
  createdAt  DateTime            @default(now())
  company    Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user       User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, isRead])
  @@index([createdAt])
}

model QuoteRequest {
  id          String    @id @default(cuid())
  companyId   String
  firstName   String
  lastName    String
  phone       String
  email       String?
  address     String?
  tradeSlug   String?
  message     String?
  isProcessed Boolean   @default(false)
  processedAt DateTime?
  createdAt   DateTime  @default(now())
  company     Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([isProcessed])
}

model AccountingExport {
  id                  String               @id @default(cuid())
  companyId           String
  periodStart         DateTime
  periodEnd           DateTime
  periodLabel         String
  type                AccountingExportType
  fileUrl             String?
  fileName            String?
  totalHT             Float                @default(0)
  totalTva0           Float                @default(0)
  totalTva55          Float                @default(0)
  totalTva10          Float                @default(0)
  totalTva20          Float                @default(0)
  totalTvaAll         Float                @default(0)
  totalTTC            Float                @default(0)
  invoiceCount        Int                  @default(0)
  paidCount           Int                  @default(0)
  pennylaneExportedAt DateTime?
  indyExportedAt      DateTime?
  createdAt           DateTime             @default(now())
  company             Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([companyId, periodStart])
}

model TvaSummary {
  id          String    @id @default(cuid())
  companyId   String
  quarter     Int
  year        Int
  caHT        Float     @default(0)
  tva0        Float     @default(0)
  tva55       Float     @default(0)
  tva10       Float     @default(0)
  tva20       Float     @default(0)
  totalTva    Float     @default(0)
  isDeclared  Boolean   @default(false)
  declaredAt  DateTime?
  declaredBy  String?
  periodStart DateTime
  periodEnd   DateTime
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  company     Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, quarter, year])
  @@index([companyId])
}

model AccountingIntegration {
  id             String             @id @default(cuid())
  companyId      String             @unique
  provider       AccountingProvider
  apiKey         String?
  apiSecret      String?
  organizationId String?
  isActive       Boolean            @default(true)
  lastSyncAt     DateTime?
  lastSyncError  String?
  syncOnCreate   Boolean            @default(false)
  syncOnSend     Boolean            @default(true)
  syncOnPaid     Boolean            @default(true)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  company        Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
}

model InvoicePaymentEvent {
  id            String   @id @default(cuid())
  invoiceId     String
  event         String
  amount        Float?
  currency      String   @default("EUR")
  stripeEventId String?  @unique
  stripeData    Json?
  clientIp      String?
  createdAt     DateTime @default(now())
  invoice       Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
}

model AuditLog {
  id         String   @id @default(cuid())
  companyId  String
  userId     String?
  action     String
  entityType String
  entityId   String
  oldData    Json?
  newData    Json?
  ipAddress  String?
  createdAt  DateTime @default(now())
  company    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user       User?    @relation(fields: [userId], references: [id])

  @@index([companyId])
  @@index([entityType, entityId])
  @@index([createdAt])
}

model AdminUser {
  id               String          @id @default(cuid())
  email            String          @unique
  password         String
  firstName        String
  lastName         String
  systemRole       SystemRole      @default(SUPPORT)
  isActive         Boolean         @default(true)
  lastLoginAt      DateTime?
  refreshTokenHash String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  auditLogs        AdminAuditLog[]
  sessions         AdminSession[]
}

model AdminSession {
  id               String    @id @default(cuid())
  adminUserId      String
  refreshTokenHash String
  device           String?
  ipAddress        String?
  expiresAt        DateTime
  lastUsedAt       DateTime  @default(now())
  createdAt        DateTime  @default(now())
  adminUser        AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)
}

model AdminAuditLog {
  id          String    @id @default(cuid())
  adminUserId String
  action      String
  targetType  String
  targetId    String
  details     Json?
  ipAddress   String?
  createdAt   DateTime  @default(now())
  adminUser   AdminUser @relation(fields: [adminUserId], references: [id])

  @@index([adminUserId])
  @@index([targetType, targetId])
}

enum PlanName {
  STARTER
  PRO
  UNLIMITED
}

enum PlanBillingCycle {
  MONTHLY
  ANNUAL
}

enum PlanStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELLED
  EXPIRED
}

enum UserRole {
  OWNER
  MANAGER
  TECHNICIAN
}

enum ClientStatus {
  OK
  WARNING
  URGENT
}

enum InterventionStatus {
